{
  "name": "quant-insight-radar",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:web": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "format": "prettier --write .",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "strategy:sync": "node --import tsx scripts/sync-strategy-catalog.ts",
    "quant:worker": "python quant-worker/worker.py",
    "quant:engine": "python -m uvicorn service:app --app-dir quant-worker --host 127.0.0.1 --port 8100",
    "market:ingest": "python quant-worker/ingest_market_data.py"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.6.26",
    "@hookform/resolvers": "^5.2.2",
