generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AppUser {
  id              String          @id @default(uuid()) @db.Uuid
  email           String          @unique
  emailVerified   Boolean         @default(false) @map("email_verified")
  name            String
  image           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  sessions        Session[]
  accounts        Account[]
  memberships     Membership[]
  invitationsSent Invitation[]    @relation("InvitationInviter")
  portfolios      Portfolio[]
  watchlistItems  WatchlistItem[]
  quantRuns       QuantRun[]
  researchRuns    ResearchRun[]

  @@map("app_users")
}

model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  token                String   @unique
  expiresAt            DateTime @map("expires_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id") @db.Uuid
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  user                 AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("auth_verifications")
}

model Organization {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  slug           String          @unique
  logo           String?
  metadata       String?         @db.Text
  createdAt      DateTime        @default(now()) @map("created_at")
  memberships    Membership[]
  invitations    Invitation[]
  portfolios     Portfolio[]
  watchlistItems WatchlistItem[]
  researchRuns   ResearchRun[]
  quantRuns      QuantRun[]

  @@map("organizations")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("organization_memberships")
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String
  role           String?
  status         String
  expiresAt      DateTime     @map("expires_at")
  inviterId      String       @map("inviter_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        AppUser      @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email])
  @@index([inviterId])
  @@map("organization_invitations")
}

model Asset {
  id             String                 @id @default(uuid()) @db.Uuid
  symbol         String                 @unique
  name           String
  assetClass     String                 @map("asset_class")
  currency       String                 @default("USD")
  provider       String?
  providerSymbol String?                @map("provider_symbol")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  bars           MarketBar[]
  positions      PortfolioPosition[]
  transactions   PortfolioTransaction[]
  watchlistItems WatchlistItem[]
  insights       AiInsight[]
  researchRuns   ResearchRun[]
  evidenceItems  EvidenceItem[]
  theses         InvestmentThesis[]
  forecasts      ForecastPoint[]
  evaluations    ModelEvaluation[]

  @@index([assetClass])
  @@map("assets")
}

model MarketBar {
  id        String   @id @default(uuid()) @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  timeframe String   @default("1d")
  ts        DateTime
  open      Decimal  @db.Decimal(20, 8)
  high      Decimal  @db.Decimal(20, 8)
  low       Decimal  @db.Decimal(20, 8)
  close     Decimal  @db.Decimal(20, 8)
  volume    Decimal? @db.Decimal(24, 4)
  source    String
  createdAt DateTime @default(now()) @map("created_at")
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, timeframe, ts])
  @@index([assetId, timeframe, ts(sort: Desc)])
  @@map("market_bars")
}

model Portfolio {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  name           String
  baseCurrency   String                 @default("USD") @map("base_currency")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AppUser                @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions      PortfolioPosition[]
  transactions   PortfolioTransaction[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([userId])
  @@map("portfolios")
}

model PortfolioPosition {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @map("portfolio_id") @db.Uuid
  assetId     String    @map("asset_id") @db.Uuid
  quantity    Decimal   @db.Decimal(28, 10)
  averageCost Decimal   @map("average_cost") @db.Decimal(20, 8)
  openedAt    DateTime  @default(now()) @map("opened_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([portfolioId, assetId])
  @@index([assetId])
  @@map("portfolio_positions")
}

model PortfolioTransaction {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @map("portfolio_id") @db.Uuid
  assetId     String    @map("asset_id") @db.Uuid
  type        String
  quantity    Decimal   @db.Decimal(28, 10)
  price       Decimal   @db.Decimal(20, 8)
  fee         Decimal   @default(0) @db.Decimal(20, 8)
  note        String?
  executedAt  DateTime  @map("executed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([portfolioId, executedAt(sort: Desc)])
  @@index([assetId])
  @@map("portfolio_transactions")
}

model WatchlistItem {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  assetId        String       @map("asset_id") @db.Uuid
  alert          Decimal?     @db.Decimal(20, 8)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, assetId])
  @@index([organizationId])
  @@index([assetId])
  @@map("watchlist_items")
}

model AiInsight {
  id            String         @id @default(uuid()) @db.Uuid
  assetId       String?        @map("asset_id") @db.Uuid
  researchRunId String?        @map("research_run_id") @db.Uuid
  source        String
  title         String
  summary       String
  sentiment     String
  confidence    Int?
  catalyst      String?
  risk          String?
  publishedAt   DateTime       @default(now()) @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  asset         Asset?         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  researchRun   ResearchRun?   @relation(fields: [researchRunId], references: [id], onDelete: SetNull)
  evidenceItems EvidenceItem[]

  @@index([assetId, publishedAt(sort: Desc)])
  @@index([researchRunId])
  @@map("ai_insights")
}

model ResearchRun {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  userId         String?            @map("user_id") @db.Uuid
  assetId        String?            @map("asset_id") @db.Uuid
  source         String
  kind           String
  status         String             @default("queued")
  parameters     Json               @default("{}")
  summary        String?
  startedAt      DateTime?          @map("started_at")
  finishedAt     DateTime?          @map("finished_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AppUser?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  asset          Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  insights       AiInsight[]
  evidence       EvidenceItem[]
  theses         InvestmentThesis[]
  forecasts      ForecastPoint[]
  providerRuns   ProviderRun[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([assetId, createdAt(sort: Desc)])
  @@index([source, kind, status])
  @@map("research_runs")
}

model EvidenceItem {
  id            String       @id @default(uuid()) @db.Uuid
  researchRunId String?      @map("research_run_id") @db.Uuid
  assetId       String?      @map("asset_id") @db.Uuid
  insightId     String?      @map("insight_id") @db.Uuid
  sourceType    String       @map("source_type")
  sourceName    String       @map("source_name")
  url           String?
  title         String
  excerpt       String       @db.Text
  engagement    Int          @default(0)
  observedAt    DateTime     @map("observed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  researchRun   ResearchRun? @relation(fields: [researchRunId], references: [id], onDelete: SetNull)
  asset         Asset?       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  insight       AiInsight?   @relation(fields: [insightId], references: [id], onDelete: SetNull)

  @@index([assetId, observedAt(sort: Desc)])
  @@index([insightId])
  @@index([researchRunId])
  @@map("evidence_items")
}

model InvestmentThesis {
  id            String       @id @default(uuid()) @db.Uuid
  assetId       String       @map("asset_id") @db.Uuid
  researchRunId String?      @map("research_run_id") @db.Uuid
  source        String
  stance        String
  conviction    Int
  thesis        String       @db.Text
  bullCase      String       @map("bull_case") @db.Text
  bearCase      String       @map("bear_case") @db.Text
  actionItems   Json         @default("[]") @map("action_items")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  asset         Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  researchRun   ResearchRun? @relation(fields: [researchRunId], references: [id], onDelete: SetNull)

  @@index([assetId, updatedAt(sort: Desc)])
  @@index([researchRunId])
  @@map("investment_theses")
}

model ForecastPoint {
  id            String       @id @default(uuid()) @db.Uuid
  assetId       String       @map("asset_id") @db.Uuid
  researchRunId String?      @map("research_run_id") @db.Uuid
  horizon       String
  targetPrice   Decimal      @map("target_price") @db.Decimal(20, 8)
  lowerBound    Decimal      @map("lower_bound") @db.Decimal(20, 8)
  upperBound    Decimal      @map("upper_bound") @db.Decimal(20, 8)
  confidence    Int
  model         String
  generatedAt   DateTime     @map("generated_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  asset         Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  researchRun   ResearchRun? @relation(fields: [researchRunId], references: [id], onDelete: SetNull)

  @@index([assetId, generatedAt(sort: Desc)])
  @@index([researchRunId])
  @@map("forecast_points")
}

model ModelEvaluation {
  id          String   @id @default(uuid()) @db.Uuid
  assetId     String?  @map("asset_id") @db.Uuid
  model       String
  task        String
  windowStart DateTime @map("window_start")
  windowEnd   DateTime @map("window_end")
  metrics     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([assetId, model, createdAt(sort: Desc)])
  @@map("model_evaluations")
}

model ProviderRun {
  id             String       @id @default(uuid()) @db.Uuid
  researchRunId  String?      @map("research_run_id") @db.Uuid
  provider       String
  status         String
  recordsFetched Int          @default(0) @map("records_fetched")
  errorMessage   String?      @map("error_message")
  startedAt      DateTime?    @map("started_at")
  finishedAt     DateTime?    @map("finished_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  researchRun    ResearchRun? @relation(fields: [researchRunId], references: [id], onDelete: SetNull)

  @@index([provider, status, createdAt(sort: Desc)])
  @@index([researchRunId])
  @@map("provider_runs")
}

model EconomicEvent {
  id        String   @id @default(uuid()) @db.Uuid
  event     String
  country   String
  impact    String
  forecast  String?
  previous  String?
  eventAt   DateTime @map("event_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventAt])
  @@map("economic_events")
}

model QuantRun {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  strategyName   String       @map("strategy_name")
  status         String       @default("queued")
  parameters     Json         @default("{}")
  metrics        Json?
  errorMessage   String?      @map("error_message")
  startedAt      DateTime?    @map("started_at")
  finishedAt     DateTime?    @map("finished_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AppUser?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@map("quant_runs")
}
