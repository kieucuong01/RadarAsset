generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AppUser {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique
  emailVerified           Boolean                  @default(false) @map("email_verified")
  name                    String
  image                   String?
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  sessions                Session[]
  accounts                Account[]
  memberships             Membership[]
  invitationsSent         Invitation[]             @relation("InvitationInviter")
  portfolios              Portfolio[]
  watchlistItems          WatchlistItem[]
  quantRuns               QuantRun[]
  researchRuns            ResearchRun[]
  customStrategies        CustomStrategy[]         @relation("CustomStrategyCreator")
  notifications           Notification[]
  marketIngestionRequests MarketIngestionRequest[]

  @@map("app_users")
}

model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  token                String   @unique
  expiresAt            DateTime @map("expires_at")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  userId               String   @map("user_id") @db.Uuid
  activeOrganizationId String?  @map("active_organization_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  user                 AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activeOrganizationId])
  @@map("auth_sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  user                  AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("auth_verifications")
}

model Organization {
  id                       String                    @id @default(uuid()) @db.Uuid
  name                     String
  slug                     String                    @unique
  logo                     String?
  metadata                 String?                   @db.Text
  createdAt                DateTime                  @default(now()) @map("created_at")
  memberships              Membership[]
  invitations              Invitation[]
  portfolios               Portfolio[]
  watchlistItems           WatchlistItem[]
  researchRuns             ResearchRun[]
  quantRuns                QuantRun[]
  quantRunArtifacts        QuantRunArtifact[]
  customStrategies         CustomStrategy[]
  customStrategyVersions   StrategyVersion[]         @relation("StrategyVersionOrganization")
  strategyAssignments      StrategyAssignment[]
  strategySignals          StrategySignal[]
  strategyEvaluationJobs   StrategyEvaluationJob[]
  strategyForwardSnapshots StrategyForwardSnapshot[]
  notifications            Notification[]
  marketIngestionRequests  MarketIngestionRequest[]

  @@map("organizations")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
  @@map("organization_memberships")
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  email          String
  role           String?
  status         String
  expiresAt      DateTime     @map("expires_at")
  inviterId      String       @map("inviter_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        AppUser      @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email])
  @@index([inviterId])
  @@map("organization_invitations")
}

model Asset {
  id                  String                 @id @default(uuid()) @db.Uuid
  symbol              String                 @unique
  canonicalKey        String?                @unique @map("canonical_key")
  name                String
  assetClass          String                 @map("asset_class")
  market              String                 @default("other")
  venue               String?
  timezone            String                 @default("UTC")
  maxLeverage         Decimal                @default(1) @map("max_leverage") @db.Decimal(5, 2)
  currency            String                 @default("USD")
  provider            String?
  providerSymbol      String?                @map("provider_symbol")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  bars                MarketBar[]
  positions           PortfolioPosition[]
  transactions        PortfolioTransaction[]
  watchlistItems      WatchlistItem[]
  insights            AiInsight[]
  researchRuns        ResearchRun[]
  evidenceItems       EvidenceItem[]
  theses              InvestmentThesis[]
  forecasts           ForecastPoint[]
  evaluations         ModelEvaluation[]
  providerInstruments ProviderInstrument[]
  datasets            Dataset[]
  quantRunLegs        QuantRunLeg[]
  strategyAssignments StrategyAssignment[]
  strategySignals     StrategySignal[]

  @@index([assetClass])
  @@map("assets")
}

model MarketBar {
  id        String   @id @default(uuid()) @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  timeframe String   @default("1d")
  ts        DateTime
  open      Decimal  @db.Decimal(20, 8)
  high      Decimal  @db.Decimal(20, 8)
  low       Decimal  @db.Decimal(20, 8)
  close     Decimal  @db.Decimal(20, 8)
  volume    Decimal? @db.Decimal(24, 4)
  source    String
  createdAt DateTime @default(now()) @map("created_at")
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, timeframe, ts])
  @@index([assetId, timeframe, ts(sort: Desc)])
  @@map("market_bars")
}

model Portfolio {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @map("organization_id") @db.Uuid
  userId              String                 @map("user_id") @db.Uuid
  name                String
  baseCurrency        String                 @default("USD") @map("base_currency")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                AppUser                @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions           PortfolioPosition[]
  transactions        PortfolioTransaction[]
  strategyAssignments StrategyAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([userId])
  @@map("portfolios")
}

model PortfolioPosition {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @map("portfolio_id") @db.Uuid
  assetId     String    @map("asset_id") @db.Uuid
  quantity    Decimal   @db.Decimal(28, 10)
  averageCost Decimal   @map("average_cost") @db.Decimal(20, 8)
  openedAt    DateTime  @default(now()) @map("opened_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset       Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([portfolioId, assetId])
  @@index([assetId])
  @@map("portfolio_positions")
}

model PortfolioTransaction {
  id             String          @id @default(uuid()) @db.Uuid
  portfolioId    String          @map("portfolio_id") @db.Uuid
  assetId        String          @map("asset_id") @db.Uuid
  sourceSignalId String?         @unique @map("source_signal_id") @db.Uuid
  type           String
  quantity       Decimal         @db.Decimal(28, 10)
  price          Decimal         @db.Decimal(20, 8)
  fee            Decimal         @default(0) @db.Decimal(20, 8)
  note           String?
  executedAt     DateTime        @map("executed_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  portfolio      Portfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset          Asset           @relation(fields: [assetId], references: [id], onDelete: Restrict)
  sourceSignal   StrategySignal? @relation(fields: [sourceSignalId], references: [id], onDelete: Restrict)

  @@index([portfolioId, executedAt(sort: Desc)])
  @@index([assetId])
  @@map("portfolio_transactions")
}

model WatchlistItem {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  assetId        String       @map("asset_id") @db.Uuid
  alert          Decimal?     @db.Decimal(20, 8)
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AppUser      @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, assetId])
  @@index([organizationId])
  @@index([assetId])
  @@map("watchlist_items")
}

model AiInsight {
  id            String         @id @default(uuid()) @db.Uuid
  assetId       String?        @map("asset_id") @db.Uuid
  researchRunId String?        @map("research_run_id") @db.Uuid
  source        String
  title         String
  summary       String
  sentiment     String
  confidence    Int?
  catalyst      String?
  risk          String?
  publishedAt   DateTime       @default(now()) @map("published_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  asset         Asset?         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  researchRun   ResearchRun?   @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  evidenceItems EvidenceItem[]

  @@index([assetId, publishedAt(sort: Desc)])
  @@index([researchRunId])
  @@map("ai_insights")
}

model ResearchRun {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  userId         String?            @map("user_id") @db.Uuid
  assetId        String?            @map("asset_id") @db.Uuid
  source         String
  kind           String
  status         String             @default("queued")
  parameters     Json               @default("{}")
  summary        String?
  startedAt      DateTime?          @map("started_at")
  finishedAt     DateTime?          @map("finished_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AppUser?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  asset          Asset?             @relation(fields: [assetId], references: [id], onDelete: SetNull)
  insights       AiInsight[]
  evidence       EvidenceItem[]
  theses         InvestmentThesis[]
  forecasts      ForecastPoint[]
  providerRuns   ProviderRun[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([assetId, createdAt(sort: Desc)])
  @@index([source, kind, status])
  @@map("research_runs")
}

model EvidenceItem {
  id            String       @id @default(uuid()) @db.Uuid
  researchRunId String?      @map("research_run_id") @db.Uuid
  assetId       String?      @map("asset_id") @db.Uuid
  insightId     String?      @map("insight_id") @db.Uuid
  sourceType    String       @map("source_type")
  sourceName    String       @map("source_name")
  url           String?
  title         String
  excerpt       String       @db.Text
  engagement    Int          @default(0)
  observedAt    DateTime     @map("observed_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  researchRun   ResearchRun? @relation(fields: [researchRunId], references: [id], onDelete: Cascade)
  asset         Asset?       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  insight       AiInsight?   @relation(fields: [insightId], references: [id], onDelete: SetNull)

  @@index([assetId, observedAt(sort: Desc)])
  @@index([insightId])
  @@index([researchRunId])
  @@map("evidence_items")
}

model InvestmentThesis {
  id            String       @id @default(uuid()) @db.Uuid
  assetId       String       @map("asset_id") @db.Uuid
  researchRunId String?      @map("research_run_id") @db.Uuid
  source        String
  stance        String
  conviction    Int
  thesis        String       @db.Text
  bullCase      String       @map("bull_case") @db.Text
  bearCase      String       @map("bear_case") @db.Text
  actionItems   Json         @default("[]") @map("action_items")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  asset         Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  researchRun   ResearchRun? @relation(fields: [researchRunId], references: [id], onDelete: Cascade)

  @@index([assetId, updatedAt(sort: Desc)])
  @@index([researchRunId])
  @@map("investment_theses")
}

model ForecastPoint {
  id            String       @id @default(uuid()) @db.Uuid
  assetId       String       @map("asset_id") @db.Uuid
  researchRunId String?      @map("research_run_id") @db.Uuid
  horizon       String
  targetPrice   Decimal      @map("target_price") @db.Decimal(20, 8)
  lowerBound    Decimal      @map("lower_bound") @db.Decimal(20, 8)
  upperBound    Decimal      @map("upper_bound") @db.Decimal(20, 8)
  confidence    Int
  model         String
  generatedAt   DateTime     @map("generated_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  asset         Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  researchRun   ResearchRun? @relation(fields: [researchRunId], references: [id], onDelete: Cascade)

  @@index([assetId, generatedAt(sort: Desc)])
  @@index([researchRunId])
  @@map("forecast_points")
}

model ModelEvaluation {
  id          String   @id @default(uuid()) @db.Uuid
  assetId     String?  @map("asset_id") @db.Uuid
  model       String
  task        String
  windowStart DateTime @map("window_start")
  windowEnd   DateTime @map("window_end")
  metrics     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)

  @@index([assetId, model, createdAt(sort: Desc)])
  @@map("model_evaluations")
}

model ProviderRun {
  id             String       @id @default(uuid()) @db.Uuid
  researchRunId  String?      @map("research_run_id") @db.Uuid
  provider       String
  status         String
  recordsFetched Int          @default(0) @map("records_fetched")
  errorMessage   String?      @map("error_message")
  startedAt      DateTime?    @map("started_at")
  finishedAt     DateTime?    @map("finished_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  researchRun    ResearchRun? @relation(fields: [researchRunId], references: [id], onDelete: Cascade)

  @@index([provider, status, createdAt(sort: Desc)])
  @@index([researchRunId])
  @@map("provider_runs")
}

model EconomicEvent {
  id        String   @id @default(uuid()) @db.Uuid
  event     String
  country   String
  impact    String
  forecast  String?
  previous  String?
  eventAt   DateTime @map("event_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([eventAt])
  @@map("economic_events")
}

model QuantRun {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  userId            String?            @map("user_id") @db.Uuid
  strategyVersionId String?            @map("strategy_version_id") @db.Uuid
  strategyName      String             @map("strategy_name")
  status            String             @default("queued")
  timeframe         String             @default("1d")
  progress          Int                @default(0)
  strategyHash      String?            @map("strategy_hash")
  datasetVersionIds Json               @default("[]") @map("dataset_version_ids")
  engineVersion     String             @default("ma-cross-v1") @map("engine_version")
  parameters        Json               @default("{}")
  metrics           Json?
  errorMessage      String?            @map("error_message")
  workerId          String?            @map("worker_id")
  leaseExpiresAt    DateTime?          @map("lease_expires_at")
  attemptCount      Int                @default(0) @map("attempt_count")
  startedAt         DateTime?          @map("started_at")
  finishedAt        DateTime?          @map("finished_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              AppUser?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  strategyVersion   StrategyVersion?   @relation(fields: [strategyVersionId], references: [id], onDelete: Restrict)
  artifacts         QuantRunArtifact[]
  legs              QuantRunLeg[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([strategyVersionId])
  @@index([status, createdAt])
  @@map("quant_runs")
}

model StrategyVersion {
  id                      String                 @id @default(uuid()) @db.Uuid
  code                    String
  version                 String
  name                    String
  category                String
  organizationId          String?                @map("organization_id") @db.Uuid
  customStrategyVersionId String?                @unique @map("custom_strategy_version_id") @db.Uuid
  status                  String                 @default("active")
  parameterSchema         Json                   @map("parameter_schema")
  defaultParameters       Json                   @map("default_parameters")
  supportedMarkets        Json                   @map("supported_markets")
  supportedTimeframes     Json                   @map("supported_timeframes")
  implementationHash      String                 @map("implementation_hash")
  sourceAttribution       String?                @map("source_attribution") @db.Text
  modificationNotice      String?                @map("modification_notice") @db.Text
  createdAt               DateTime               @default(now()) @map("created_at")
  organization            Organization?          @relation("StrategyVersionOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  customStrategyVersion   CustomStrategyVersion? @relation(fields: [customStrategyVersionId], references: [id], onDelete: Restrict)
  quantRuns               QuantRun[]
  quantRunLegs            QuantRunLeg[]
  assignments             StrategyAssignment[]
  signals                 StrategySignal[]

  @@unique([code, version])
  @@index([organizationId, status])
  @@index([status, code])
  @@map("strategy_versions")
}

model CustomStrategy {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  createdByUserId String?                 @map("created_by_user_id") @db.Uuid
  name            String
  description     String?                 @db.Text
  family          String
  status          String                  @default("active")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       AppUser?                @relation("CustomStrategyCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  versions        CustomStrategyVersion[]

  @@index([organizationId, status, updatedAt(sort: Desc)])
  @@map("custom_strategies")
}

model CustomStrategyVersion {
  id                 String           @id @default(uuid()) @db.Uuid
  customStrategyId   String           @map("custom_strategy_id") @db.Uuid
  version            String
  kind               String
  ruleDefinition     Json             @map("rule_definition")
  implementationHash String           @map("implementation_hash")
  status             String           @default("active")
  createdAt          DateTime         @default(now()) @map("created_at")
  customStrategy     CustomStrategy   @relation(fields: [customStrategyId], references: [id], onDelete: Cascade)
  executionVersion   StrategyVersion?

  @@unique([customStrategyId, version])
  @@unique([customStrategyId, implementationHash])
  @@map("custom_strategy_versions")
}

model StrategyAssignment {
  id                            String                    @id @default(uuid()) @db.Uuid
  organizationId                String                    @map("organization_id") @db.Uuid
  portfolioId                   String                    @map("portfolio_id") @db.Uuid
  assetId                       String                    @map("asset_id") @db.Uuid
  strategyVersionId             String                    @map("strategy_version_id") @db.Uuid
  parameters                    Json                      @default("{}")
  status                        String                    @default("active")
  activatedAt                   DateTime?                 @map("activated_at")
  lastEvaluatedAt               DateTime?                 @map("last_evaluated_at")
  lastEvaluatedDatasetVersionId String?                   @map("last_evaluated_dataset_version_id") @db.Uuid
  lastEvaluatedBarAt            DateTime?                 @map("last_evaluated_bar_at") @db.Timestamptz(3)
  state                         Json                      @default("{}")
  sourceQuantRunId              String?                   @map("source_quant_run_id") @db.Uuid
  sourceQuantRunLegId           String?                   @map("source_quant_run_leg_id") @db.Uuid
  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")
  organization                  Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portfolio                     Portfolio                 @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset                         Asset                     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  strategyVersion               StrategyVersion           @relation(fields: [strategyVersionId], references: [id], onDelete: Restrict)
  signals                       StrategySignal[]
  evaluationJobs                StrategyEvaluationJob[]
  forwardSnapshots              StrategyForwardSnapshot[]
  notifications                 Notification[]

  @@unique([portfolioId, assetId])
  @@index([organizationId, status])
  @@index([strategyVersionId])
  @@map("strategy_assignments")
}

model StrategySignal {
  id                    String                 @id @default(uuid()) @db.Uuid
  organizationId        String                 @map("organization_id") @db.Uuid
  assignmentId          String                 @map("assignment_id") @db.Uuid
  assetId               String                 @map("asset_id") @db.Uuid
  strategyVersionId     String                 @map("strategy_version_id") @db.Uuid
  datasetVersionId      String?                @map("dataset_version_id") @db.Uuid
  signalType            String                 @map("signal_type")
  eventType             String                 @default("signal") @map("event_type")
  status                String                 @default("suggested")
  signalAt              DateTime               @map("signal_at")
  executionAt           DateTime?              @map("execution_at")
  signalPrice           Decimal?               @map("signal_price") @db.Decimal(20, 8)
  reason                String?
  metadata              Json                   @default("{}")
  createdAt             DateTime               @default(now()) @map("created_at")
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignment            StrategyAssignment     @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  asset                 Asset                  @relation(fields: [assetId], references: [id], onDelete: Restrict)
  strategyVersion       StrategyVersion        @relation(fields: [strategyVersionId], references: [id], onDelete: Restrict)
  datasetVersion        DatasetVersion?        @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)
  notifications         Notification[]
  portfolioTransactions PortfolioTransaction[]

  @@index([organizationId, status, signalAt(sort: Desc)])
  @@index([assetId, signalAt(sort: Desc)])
  @@index([datasetVersionId])
  @@map("strategy_signals")
}

model StrategyEvaluationJob {
  id               String             @id @default(uuid()) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  assignmentId     String             @map("assignment_id") @db.Uuid
  datasetVersionId String             @map("dataset_version_id") @db.Uuid
  status           String             @default("queued")
  attemptCount     Int                @default(0) @map("attempt_count")
  workerId         String?            @map("worker_id")
  leaseExpiresAt   DateTime?          @map("lease_expires_at")
  errorCode        String?            @map("error_code")
  createdAt        DateTime           @default(now()) @map("created_at")
  finishedAt       DateTime?          @map("finished_at")
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignment       StrategyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  datasetVersion   DatasetVersion     @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, datasetVersionId])
  @@index([status, createdAt])
  @@map("strategy_evaluation_jobs")
}

model StrategyForwardSnapshot {
  id                        String             @id @default(uuid()) @db.Uuid
  organizationId            String             @map("organization_id") @db.Uuid
  assignmentId              String             @map("assignment_id") @db.Uuid
  datasetVersionId          String             @map("dataset_version_id") @db.Uuid
  barAt                     DateTime           @map("bar_at") @db.Timestamptz(3)
  simulatedCash             Decimal            @map("simulated_cash") @db.Decimal(24, 8)
  simulatedQuantity         Decimal            @map("simulated_quantity") @db.Decimal(28, 10)
  marketValue               Decimal            @map("market_value") @db.Decimal(24, 8)
  equity                    Decimal            @db.Decimal(24, 8)
  cumulativeContributions   Decimal            @map("cumulative_contributions") @db.Decimal(24, 8)
  cumulativeFees            Decimal            @map("cumulative_fees") @db.Decimal(24, 8)
  pnlExcludingContributions Decimal            @map("pnl_excluding_contributions") @db.Decimal(24, 8)
  benchmarkEquity           Decimal            @map("benchmark_equity") @db.Decimal(24, 8)
  createdAt                 DateTime           @default(now()) @map("created_at")
  organization              Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignment                StrategyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  datasetVersion            DatasetVersion     @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, datasetVersionId, barAt])
  @@index([organizationId, assignmentId, barAt])
  @@map("strategy_forward_snapshots")
}

model Notification {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  assignmentId   String             @map("assignment_id") @db.Uuid
  signalId       String             @map("signal_id") @db.Uuid
  type           String
  title          String
  body           String
  readAt         DateTime?          @map("read_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AppUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment     StrategyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  signal         StrategySignal     @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([userId, signalId])
  @@index([organizationId, userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model DataProvider {
  id           String               @id @default(uuid()) @db.Uuid
  code         String               @unique
  name         String
  termsUrl     String?              @map("terms_url")
  licenseScope String               @default("research_only") @map("license_scope")
  status       String               @default("active")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  instruments  ProviderInstrument[]
  versions     DatasetVersion[]

  @@map("data_providers")
}

model ProviderInstrument {
  id                String                   @id @default(uuid()) @db.Uuid
  providerId        String                   @map("provider_id") @db.Uuid
  assetId           String                   @map("asset_id") @db.Uuid
  providerSymbol    String                   @map("provider_symbol")
  metadata          Json                     @default("{}")
  createdAt         DateTime                 @default(now()) @map("created_at")
  provider          DataProvider             @relation(fields: [providerId], references: [id], onDelete: Cascade)
  asset             Asset                    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  ingestionRequests MarketIngestionRequest[]

  @@unique([providerId, providerSymbol])
  @@unique([providerId, assetId])
  @@index([assetId])
  @@map("provider_instruments")
}

model Dataset {
  id               String           @id @default(uuid()) @db.Uuid
  assetId          String           @map("asset_id") @db.Uuid
  timeframe        String
  adjustmentPolicy String           @default("raw") @map("adjustment_policy")
  createdAt        DateTime         @default(now()) @map("created_at")
  asset            Asset            @relation(fields: [assetId], references: [id], onDelete: Cascade)
  versions         DatasetVersion[]

  @@unique([assetId, timeframe, adjustmentPolicy])
  @@index([assetId, timeframe])
  @@map("datasets")
}

model DatasetVersion {
  id                       String                    @id @default(uuid()) @db.Uuid
  datasetId                String                    @map("dataset_id") @db.Uuid
  providerId               String                    @map("provider_id") @db.Uuid
  version                  Int
  checksum                 String
  coverageStart            DateTime                  @map("coverage_start")
  coverageEnd              DateTime                  @map("coverage_end")
  rowCount                 Int                       @map("row_count")
  missingBarCount          Int                       @default(0) @map("missing_bar_count")
  qualityStatus            String                    @default("passed") @map("quality_status")
  qualitySummary           Json                      @default("{}") @map("quality_summary")
  sourceMetadata           Json                      @default("{}") @map("source_metadata")
  isActive                 Boolean                   @default(false) @map("is_active")
  publishedAt              DateTime                  @default(now()) @map("published_at")
  dataset                  Dataset                   @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  provider                 DataProvider              @relation(fields: [providerId], references: [id], onDelete: Restrict)
  bars                     DatasetBar[]
  issues                   DataQualityIssue[]
  ingestionRuns            MarketIngestionRun[]
  quantRunLegs             QuantRunLeg[]
  ingestionRequests        MarketIngestionRequest[]
  strategySignals          StrategySignal[]
  strategyEvaluationJobs   StrategyEvaluationJob[]
  strategyForwardSnapshots StrategyForwardSnapshot[]

  @@unique([datasetId, version])
  @@index([datasetId, isActive])
  @@index([providerId])
  @@map("dataset_versions")
}

model DatasetBar {
  id               String         @id @default(uuid()) @db.Uuid
  datasetVersionId String         @map("dataset_version_id") @db.Uuid
  ts               DateTime       @db.Timestamptz(3)
  open             Decimal        @db.Decimal(20, 8)
  high             Decimal        @db.Decimal(20, 8)
  low              Decimal        @db.Decimal(20, 8)
  close            Decimal        @db.Decimal(20, 8)
  volume           Decimal?       @db.Decimal(24, 4)
  source           String
  qualityFlags     Json           @default("[]") @map("quality_flags")
  ingestedAt       DateTime       @default(now()) @map("ingested_at")
  datasetVersion   DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@unique([datasetVersionId, ts])
  @@index([datasetVersionId, ts])
  @@map("dataset_bars")
}

model DataQualityIssue {
  id               String         @id @default(uuid()) @db.Uuid
  datasetVersionId String         @map("dataset_version_id") @db.Uuid
  code             String
  severity         String
  ts               DateTime?
  details          Json           @default("{}")
  createdAt        DateTime       @default(now()) @map("created_at")
  datasetVersion   DatasetVersion @relation(fields: [datasetVersionId], references: [id], onDelete: Cascade)

  @@index([datasetVersionId, severity])
  @@map("data_quality_issues")
}

model MarketIngestionRun {
  id               String          @id @default(uuid()) @db.Uuid
  providerCode     String          @map("provider_code")
  assetSymbol      String          @map("asset_symbol")
  timeframe        String
  scheduledAt      DateTime        @map("scheduled_at") @db.Timestamptz(3)
  startedAt        DateTime        @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt       DateTime?       @map("finished_at") @db.Timestamptz(3)
  status           String
  attemptCount     Int             @default(0) @map("attempt_count")
  fetchedRowCount  Int             @default(0) @map("fetched_row_count")
  datasetVersionId String?         @map("dataset_version_id") @db.Uuid
  errorCode        String?         @map("error_code")
  errorMessage     String?         @map("error_message")
  metadata         Json            @default("{}")
  datasetVersion   DatasetVersion? @relation(fields: [datasetVersionId], references: [id], onDelete: SetNull)

  @@index([assetSymbol, timeframe, startedAt(sort: Desc)])
  @@index([status, startedAt])
  @@index([datasetVersionId])
  @@map("market_ingestion_runs")
}

model MarketIngestionRequest {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  providerInstrumentId String             @map("provider_instrument_id") @db.Uuid
  timeframe            String
  status               String             @default("queued")
  attemptCount         Int                @default(0) @map("attempt_count")
  availableAt          DateTime           @default(now()) @map("available_at") @db.Timestamptz(3)
  workerId             String?            @map("worker_id")
  leaseExpiresAt       DateTime?          @map("lease_expires_at") @db.Timestamptz(3)
  datasetVersionId     String?            @map("dataset_version_id") @db.Uuid
  errorCode            String?            @map("error_code")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                 AppUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerInstrument   ProviderInstrument @relation(fields: [providerInstrumentId], references: [id], onDelete: Restrict)
  datasetVersion       DatasetVersion?    @relation(fields: [datasetVersionId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([userId, status])
  @@index([providerInstrumentId])
  @@index([datasetVersionId])
  @@index([status, availableAt])
  @@map("market_ingestion_requests")
}

model QuantRunArtifact {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  quantRunId     String       @map("quant_run_id") @db.Uuid
  quantRunLegId  String?      @map("quant_run_leg_id") @db.Uuid
  scopeKey       String       @default("aggregate") @map("scope_key")
  kind           String
  checksum       String
  payload        Json
  rowCount       Int          @default(0) @map("row_count")
  schemaVersion  Int          @default(1) @map("schema_version")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quantRun       QuantRun     @relation(fields: [quantRunId], references: [id], onDelete: Cascade)
  quantRunLeg    QuantRunLeg? @relation(fields: [quantRunLegId], references: [id], onDelete: Cascade)

  @@unique([quantRunId, scopeKey, kind])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([quantRunLegId])
  @@map("quant_run_artifacts")
}

model QuantRunLeg {
  id                 String             @id @default(uuid()) @db.Uuid
  quantRunId         String             @map("quant_run_id") @db.Uuid
  assetId            String             @map("asset_id") @db.Uuid
  datasetVersionId   String             @map("dataset_version_id") @db.Uuid
  strategyVersionId  String             @map("strategy_version_id") @db.Uuid
  symbolSnapshot     String             @map("symbol_snapshot")
  marketSnapshot     String             @map("market_snapshot")
  currencySnapshot   String             @map("currency_snapshot")
  allocationBps      Int                @map("allocation_bps")
  initialNotional    Decimal            @map("initial_notional") @db.Decimal(24, 8)
  leverage           Decimal            @db.Decimal(5, 2)
  parameters         Json               @default("{}")
  implementationHash String             @map("implementation_hash")
  status             String             @default("queued")
  progress           Int                @default(0)
  metrics            Json?
  errorCode          String?            @map("error_code")
  createdAt          DateTime           @default(now()) @map("created_at")
  quantRun           QuantRun           @relation(fields: [quantRunId], references: [id], onDelete: Cascade)
  asset              Asset              @relation(fields: [assetId], references: [id], onDelete: Restrict)
  datasetVersion     DatasetVersion     @relation(fields: [datasetVersionId], references: [id], onDelete: Restrict)
  strategyVersion    StrategyVersion    @relation(fields: [strategyVersionId], references: [id], onDelete: Restrict)
  artifacts          QuantRunArtifact[]

  @@unique([quantRunId, assetId])
  @@index([assetId])
  @@index([datasetVersionId])
  @@index([strategyVersionId])
  @@map("quant_run_legs")
}
